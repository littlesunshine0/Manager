    func generateSocialContent(weeklyGain: Decimal, topCard: BaseballCardModel) -> SocialContent {
        let gainPercent = Double(truncating: (weeklyGain / (topCard.purchasePrice ?? 1) * 100) as NSNumber)
        
        return SocialContent(
            videoScript: String(format: "This week's biggest winner: %@ up %.1f%%! 📈⚾", topCard.playerName, gainPercent),
            hashtags: ["#BaseballCards", "#Investing", "#\(topCard.playerName.replacingOccurrences(of: " ", with: ""))"],
