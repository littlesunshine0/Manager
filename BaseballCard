                    Text("Top Holding: \(risk.topPlayer)")
                        .font(.subheadline)
                    Text(String(format: "%.1f%% of portfolio", risk.concentrationPercent))
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
                
                Spacer()
                
                VStack {
                    Text(String(describing: risk.riskLevel))
                        .font(.caption)
                        .padding(.horizontal, 8)
                        .padding(.vertical, 4)
                        .background(riskColor.opacity(0.2))
                        .foregroundColor(riskColor)
                        .cornerRadius(4)
                }
            }
            
            Text(risk.recommendation)
                .font(.caption)
                .foregroundColor(.secondary)
                .padding(.top, 4)
        }
        .padding()
        .background(Color.gray.opacity(0.1))
        .cornerRadius(8)
    }
    
    private var vintagePremiumSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            Text("Vintage Premium Potential")
                .font(.headline)
            
            let premiums = AdvancedAnalytics.analyzeVintagePremium(cards: cards)
            
            ForEach(premiums, id: \.era) { premium in
                
                HStack {
                    VStack(alignment: .leading) {
                        Text(premium.era)
                            .font(.subheadline)
                            .fontWeight(.medium)
                        Text("\(premium.premiumCards)/\(premium.totalCards) premium cards")
                            .font(.caption)
                            .foregroundColor(.secondary)
                    }
                    
                    Spacer()
                    
                    VStack(alignment: .trailing) {
                        Text(String(format: "%.1f%%", premium.premiumPercent))
                            .font(.subheadline)
                            .fontWeight(.bold)
                        Text(String(format: "$%.0f avg", NSDecimalNumber(decimal: premium.avgValue).doubleValue))
                            .font(.caption)
                            .foregroundColor(.secondary)
                    }
                }
                
                if !premium.opportunity.contains("Standard") {
                    Text(premium.opportunity)
                        .font(.caption)
                        .foregroundColor(.blue)
                        .padding(.top, 2)
                }
            }
        }
        .padding()
        .background(Color.gray.opacity(0.1))
        .cornerRadius(8)
    }
    
    private var rookieFocusSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            Text("Rookie Card Focus")
                .font(.headline)
            
            let rookieFocus = AdvancedAnalytics.analyzeRookieFocus(cards: cards)
            
            HStack {
                VStack(alignment: .leading) {
                    Text("\(rookieFocus.totalRookies) Rookie Cards")
                        .font(.subheadline)
                        .fontWeight(.medium)
                    Text(String(format: "$%.0f total value", NSDecimalNumber(decimal: rookieFocus.rookieValue).doubleValue))
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
                
                Spacer()
                
                VStack(alignment: .trailing) {
                    Text(String(format: "%.1f%%", rookieFocus.rookieValuePercent))
                        .font(.title3)
                        .fontWeight(.bold)
                    Text("of portfolio")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
            
            Text(rookieFocus.strategy)
                .font(.caption)
                .foregroundColor(.blue)
                .padding(.top, 4)
        }
        .padding()
        .background(Color.gray.opacity(0.1))
        .cornerRadius(8)
    }
    
    private var optimizationSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            Text("Portfolio Optimizer")
                .font(.headline)
            
            let suggestions = AdvancedAnalytics.generateOptimizationSuggestions(cards: cards)
            
            ForEach(suggestions.indices, id: \.self) { index in
                let suggestion = suggestions[index]
                
                VStack(alignment: .leading, spacing: 8) {
                    HStack {
                        Text(suggestion.title)
                            .font(.subheadline)
                            .fontWeight(.medium)
                        
                        Spacer()
                        
                        Text(suggestion.priority == .high ? "HIGH" : suggestion.priority == .medium ? "MED" : "LOW")
                            .font(.caption)
                            .padding(.horizontal, 6)
                            .padding(.vertical, 2)
                            .background(suggestion.priority.color.opacity(0.2))
                            .foregroundColor(suggestion.priority.color)
                            .cornerRadius(4)
                    }
                    
                    Text(suggestion.description)
                        .font(.caption)
                        .foregroundColor(.secondary)
                    
                    Text("Impact: \(suggestion.impact)")
                        .font(.caption)
                        .foregroundColor(.blue)
                }
                .padding()
                .background(Color.blue.opacity(0.05))
                .cornerRadius(6)
            }
        }
        .padding()
        .background(Color.gray.opacity(0.1))
        .cornerRadius(8)
    }
    
    private var aiAssistantSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            Text("AI Assistant")
                .font(.headline)
            
            HStack {
                TextField("Ask about your collection...", text: $queryText)
                    .textFieldStyle(RoundedBorderTextFieldStyle())
                
                Button("Ask") {
                    Task {
                        await aiAssistant.sendMessage(queryText)
                        await MainActor.run { queryText = "" }
                    }
                }
                .disabled(queryText.isEmpty || aiAssistant.isTyping)
            }

            if aiAssistant.isTyping {
                HStack {
                    ProgressView()
                        .scaleEffect(0.8)
                    Text("Analyzing...")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
            
            ForEach(Array(aiAssistant.responses.suffix(3)).enumerated(), id: \.offset) { _, response in
                
                VStack(alignment: .leading, spacing: 4) {
                    Text("Q: \(response.query)")
                        .font(.caption)
                        .fontWeight(.medium)
                    
                    Text("A: \(response.response)")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
                .padding(8)
                .background(Color.blue.opacity(0.05))
                .cornerRadius(6)
            }
        }
        .padding()
        .background(Color.gray.opacity(0.1))
        .cornerRadius(8)
    }
}


