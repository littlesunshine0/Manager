// Portfolio Analytics (investment tracking)
struct PortfolioAnalytics {
    static func calculatePerformance(for cards: [BaseballCardModel]) -> PortfolioSummary {
        let totalAcquisitionCost = cards.compactMap { $0.acquisitionCost }.reduce(0, +)
        let totalCurrentValue = cards.compactMap { $0.currentMarketValue }.reduce(0, +)
        let totalGainLoss = totalCurrentValue - totalAcquisitionCost
        let performancePercent = totalAcquisitionCost > 0 ? Double(truncating: (totalGainLoss / totalAcquisitionCost * 100) as NSNumber) : 0.0

        let topPerformers = cards
            .filter { (card: BaseballCardModel) -> Bool in
                (card.performancePercent ?? 0) > 0
            }
            .sorted(by: { (a, b) in
                (a.performancePercent ?? 0) > (b.performancePercent ?? 0)
            })
            .prefix(5)

        let biggestLosers = cards
            .filter { (card: BaseballCardModel) -> Bool in
                (card.performancePercent ?? 0) < 0
            }
            .sorted(by: { (a, b) in
                (a.performancePercent ?? 0) < (b.performancePercent ?? 0)
            })
            .prefix(5)

        return PortfolioSummary(
            totalCards: cards.count,
            totalAcquisitionCost: totalAcquisitionCost,
            totalCurrentValue: totalCurrentValue,
            totalGainLoss: totalGainLoss,
            performancePercent: performancePercent,
            topPerformers: Array(topPerformers),
            biggestLosers: Array(biggestLosers)
        )
    }

    struct PortfolioSummary {
        let totalCards: Int
        let totalAcquisitionCost: Decimal
        let totalCurrentValue: Decimal
        let totalGainLoss: Decimal
        let performancePercent: Double
        let topPerformers: [BaseballCardModel]
        let biggestLosers: [BaseballCardModel]
    }
}

