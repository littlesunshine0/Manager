    func generatePersonalizedSuggestions(for cards: [BaseballCardModel]) {
        // Analyze collection and generate personalized suggestions
        var newSuggestions: [Suggestion] = []
        
        // Check for grading opportunities
        let ungradedValuableCards = cards.filter {
            $0.gradeCompany == .raw &&
            ($0.estimatedValue ?? 0) > 100 &&
            ($0.conditionEstimate == .mint || $0.conditionEstimate == .nearMint)
        }
        
        if !ungradedValuableCards.isEmpty {
            newSuggestions.append(Suggestion(
                title: "Grade Your Best Cards",
                description: "I found \(ungradedValuableCards.count) high-value cards in excellent condition that could benefit from grading",
                category: .grading,
                priority: .high,
                actionable: true,
                relatedCards: Array(ungradedValuableCards.prefix(3)),
                estimatedImpact: "Potential 25-50% value increase"
            ))
        }
        
        // Check for collection gaps
        let playerCounts = Dictionary(grouping: cards, by: \.playerName)
        let topPlayers = playerCounts.sorted(by: { $0.value.count > $1.value.count }).prefix(3)
        
        for (player, playerCards) in topPlayers {
            let years = Set(playerCards.map(\.cardYear))
            let missingYears = Set(1990...1995).subtracting(years)
            
            if !missingYears.isEmpty {
                newSuggestions.append(Suggestion(
                    title: "Complete \(player) Collection",
                    description: "You're missing \(player) cards from \(missingYears.sorted().map(String.init).joined(separator: ", "))",
                    category: .buying,
                    priority: .medium,
                    actionable: true,
                    relatedCards: playerCards,
                    estimatedImpact: "Collection completeness bonus"
                ))
            }
        }
        
        suggestions = newSuggestions + suggestions.filter { suggestion in
            !newSuggestions.contains { $0.title == suggestion.title }
        }
    }
}



