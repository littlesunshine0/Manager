public enum CardSort: CaseIterable {
    case yearDesc, valueDesc, playerAZ, brandAZ, createdDesc

    var descriptors: [NSSortDescriptor] {
        switch self {
        case .yearDesc:   return [NSSortDescriptor(key: #keyPath(BaseballCard.cardYear), ascending: false),
                                  NSSortDescriptor(key: #keyPath(BaseballCard.playerName), ascending: true)]
        case .valueDesc:  return [NSSortDescriptor(key: #keyPath(BaseballCard.estimatedValue), ascending: false)]
        case .playerAZ:   return [NSSortDescriptor(key: #keyPath(BaseballCard.playerName), ascending: true)]
        case .brandAZ:    return [NSSortDescriptor(key: #keyPath(BaseballCard.brand), ascending: true),
                                  NSSortDescriptor(key: #keyPath(BaseballCard.setName), ascending: true)]
        case .createdDesc:return [NSSortDescriptor(key: #keyPath(BaseballCard.createdAt), ascending: false)]
        }
    }
}

public extension CardFilter {
    func predicate() -> NSPredicate? {
        var subs: [NSPredicate] = []

        if !text.isEmpty {
            let t = text as NSString
            subs += [NSPredicate(format: "playerName CONTAINS[cd] %@ OR brand CONTAINS[cd] %@ OR setName CONTAINS[cd] %@ OR cardNumber CONTAINS[cd] %@", t, t, t, t)]
        }
        if let r = rookie { subs.append(NSPredicate(format: "rookie == %@", NSNumber(value: r))) }
        if let a = autograph { subs.append(NSPredicate(format: "autograph == %@", NSNumber(value: a))) }
        if !gradeCompanies.isEmpty {
            let raw = gradeCompanies.map { NSNumber(value: $0.rawValue) }
            subs.append(NSPredicate(format: "gradeCompanyRaw IN %@", raw))
        }
        if !brands.isEmpty {
            subs.append(NSPredicate(format: "brand IN %@", brands.map{$0}))
        }
        if let lo = minYear { subs.append(NSPredicate(format: "cardYear >= %d", lo)) }
        if let hi = maxYear { subs.append(NSPredicate(format: "cardYear <= %d", hi)) }
        if let lo = minValue { subs.append(NSPredicate(format: "estimatedValue >= %@", NSDecimalNumber(decimal: lo))) }
        if let hi = maxValue { subs.append(NSPredicate(format: "estimatedValue <= %@", NSDecimalNumber(decimal: hi))) }

        return subs.isEmpty ? nil : NSCompoundPredicate(andPredicateWithSubpredicates: subs)
    }
}

