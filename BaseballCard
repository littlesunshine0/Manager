                }
            }
        }
        
        // Learn about budget preferences
        if lowercaseMessage.contains("expensive") || lowercaseMessage.contains("cheap") || lowercaseMessage.contains("budget") {
            let insight = LearningInsight(
                category: .behaviorTrend,
                title: "Budget Consciousness",
                description: "User is price-sensitive in their collecting approach",
                confidence: 0.6,
                learnedAt: Date(),
                applicableScenarios: ["Price recommendations", "Value suggestions"]
            )
            learningInsights.append(insight)
        }
        
        // Update behavior patterns
        userProfile.behavior.frequentActions.append(userMessage)
        if userProfile.behavior.frequentActions.count > 50 {
            userProfile.behavior.frequentActions.removeFirst()
        }
    }
    
