public extension BaseballCard {
    var gradeCompany: GradingCompany {
        get { GradingCompany(rawValue: gradeCompanyRaw) ?? .raw }
        set { gradeCompanyRaw = newValue.rawValue }
    }

    var conditionEstimate: ConditionEstimate {
        get { ConditionEstimate(rawValue: conditionEstimateRaw) ?? .unknown }
        set { conditionEstimateRaw = newValue.rawValue }
    }

    var purchasePriceDecimal: Decimal? {
        get { purchasePrice?.decimalValue }
        set { purchasePrice = newValue.map { NSDecimalNumber(decimal: $0) } }
    }

    var estimatedValueDecimal: Decimal? {
        get { estimatedValue?.decimalValue }
        set { estimatedValue = newValue.map { NSDecimalNumber(decimal: $0) } }
    }

    var identityKey: String {
        "\(cardYear)-\(brand)-\(setName)-#\(cardNumber)-\(playerName)".lowercased()
    }

    var isNumbered: Bool { serialNumber?.isEmpty == false }

    var gradeDisplay: String {
        let company = gradeCompany == .raw ? "RAW" : gradeCompany.description
        if let g = gradeLabel, !g.isEmpty { return "\(company) \(g)" }
        return company
    }
}

