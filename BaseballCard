    func sendMessage(_ content: String) async {
        guard let conversation = currentConversation else { return }
        
        // Add user message
        let userMessage = Message(
            content: content,
            sender: .user,
            timestamp: Date(),
            type: .text,
            attachments: []
        )
        
        addMessage(userMessage, to: conversation.id)
        
        // Generate AI response
        isTyping = true
        
        do {
            let response = try await generateResponse(to: content, conversation: conversation)
            let assistantMessage = Message(
                content: response.content,
                sender: .assistant,
                timestamp: Date(),
                type: response.type,
                attachments: response.attachments
            )
            
            addMessage(assistantMessage, to: conversation.id)
            
            // Learn from interaction
            await learnFromInteraction(userMessage: content, context: conversation)
            
        } catch {
            let errorMessage = Message(
                content: "I'm sorry, I'm having trouble processing that right now. Could you try rephrasing your question?",
                sender: .assistant,
                timestamp: Date(),
                type: .text,
                attachments: []
            )
            addMessage(errorMessage, to: conversation.id)
        }
        
        isTyping = false
    }
    
    private func generateResponse(to message: String, conversation: Conversation) async throws -> (content: String, type: Message.MessageType, attachments: [Message.MessageAttachment]) {
        
        // Simulate AI processing time
        try await Task.sleep(nanoseconds: 1_500_000_000)
        
        let lowercaseMessage = message.lowercased()
        
        // Card valuation queries
        if lowercaseMessage.contains("value") || lowercaseMessage.contains("worth") || lowercaseMessage.contains("price") {
            return generateValuationResponse(message: message)
        }
        
        // Market advice queries
        if lowercaseMessage.contains("market") || lowercaseMessage.contains("invest") || lowercaseMessage.contains("buy") || lowercaseMessage.contains("sell") {
            return generateMarketAdviceResponse(message: message)
        }
        
        // Authentication queries
        if lowercaseMessage.contains("authentic") || lowercaseMessage.contains("fake") || lowercaseMessage.contains("real") {
            return generateAuthenticationResponse(message: message)
        }
        
        // Grading queries
        if lowercaseMessage.contains("grade") || lowercaseMessage.contains("condition") || lowercaseMessage.contains("psa") || lowercaseMessage.contains("bgs") {
            return generateGradingResponse(message: message)
        }
        
        // Collection strategy
        if lowercaseMessage.contains("collect") || lowercaseMessage.contains("strategy") || lowercaseMessage.contains("focus") {
            return generateCollectionStrategyResponse(message: message)
        }
        
        // General conversation
        return generateGeneralResponse(message: message)
    }
    
    private func generateValuationResponse(message: String) -> (content: String, type: Message.MessageType, attachments: [Message.MessageAttachment]) {
        let responses = [
            "Card values can vary significantly based on condition, rarity, and market demand. For the most accurate valuation, I'd recommend checking recent sold listings on eBay or consulting professional price guides like Beckett.",
            "Great question about card values! The key factors that affect a card's worth are: condition (mint cards are worth much more), player popularity, card rarity, and current market trends. What specific card are you curious about?",
            "Valuing cards is both an art and a science! I can help you understand the factors that drive prices. Recent sales data is usually the best indicator - would you like me to walk you through how to research comparable sales?"
        ]
        
        return (
            content: responses.randomElement() ?? responses[0],
            type: .text,
            attachments: []
        )
    }
    
