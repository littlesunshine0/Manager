public enum CardCondition: String, CaseIterable, Codable, CustomStringConvertible {
    case mint = "Mint"
    case nearMint = "Near Mint"
    case excellent = "Excellent"
    case veryGood = "Very Good"
    case good = "Good"
    case fair = "Fair"
    case poor = "Poor"

    public var description: String { rawValue }

    // Bridge to existing ConditionEstimate used by Core Data
    var estimate: ConditionEstimate {
        switch self {
        case .mint: return .mint
        case .nearMint: return .nearMint
        case .excellent: return .excellent
        case .veryGood: return .veryGood
        case .good: return .good
        case .fair: return .fair
        case .poor: return .poor
        }
    }

    init(from estimate: ConditionEstimate) {
        switch estimate {
        case .gemMint, .mint: self = .mint
        case .nearMint, .nmMt, .exMt: self = .nearMint
        case .excellent: self = .excellent
        case .veryGood: self = .veryGood
        case .good: self = .good
        case .fair: self = .fair
        default: self = .poor
        }
    }
}

// MARK: - Core Data Manager

@MainActor
final class CoreDataManager {
    let context: NSManagedObjectContext
    init(context: NSManagedObjectContext) { self.context = context }

    // CRUD
    @discardableResult
    func create(from model: BaseballCardModel) throws -> BaseballCard {
        let obj = BaseballCard(context: context)
        model.apply(to: obj)
        if obj.createdAt == Date.distantPast || obj.createdAt == .distantFuture { obj.createdAt = Date() }
        obj.updatedAt = Date()
        try save()
        return obj
    }

    func fetchAll(sortedBy sort: CardSort = .yearDesc) throws -> [BaseballCard] {
        let req: NSFetchRequest<BaseballCard> = BaseballCard.fetchRequest()
        req.sortDescriptors = sort.descriptors
        return try context.fetch(req)
    }

    func fetch(using filter: CardFilter, sort: CardSort) throws -> [BaseballCard] {
        let req: NSFetchRequest<BaseballCard> = BaseballCard.fetchRequest()
        req.predicate = filter.predicate()
        req.sortDescriptors = sort.descriptors
        return try context.fetch(req)
    }

    func delete(_ obj: BaseballCard) throws {
        context.delete(obj)
        try save()
    }

    func save() throws {
        if context.hasChanges { try context.save() }
    }

    // Search helpers
    func search(text: String) throws -> [BaseballCard] {
        var f = CardFilter()
        f.text = text
        return try fetch(using: f, sort: .playerAZ)
    }
}

// MARK: - Validation Service

struct ValidationService {
    enum ValidationError: LocalizedError, Equatable {
        case playerName(String)
        case cardYear(String)
        case cardSet(String)
        case cardNumber(String)
        case estimatedValue(String)

        var errorDescription: String? {
            switch self {
            case .playerName(let m): return m
            case .cardYear(let m): return m
            case .cardSet(let m): return m
            case .cardNumber(let m): return m
            case .estimatedValue(let m): return m
            }
        }
    }

    func validatePlayerName(_ s: String) -> ValidationError? {
        guard !s.isEmpty else { return .playerName("Player name is required.") }
        guard s.count <= 50 else { return .playerName("Max 50 characters.") }
        let ok = s.range(of: "^[A-Za-z ]+$", options: .regularExpression) != nil
        return ok ? nil : .playerName("Letters and spaces only.")
    }

    func validateYear(_ y: Int) -> ValidationError? {
        (1990...1995).contains(y) ? nil : .cardYear("Year must be between 1990 and 1995.")
    }

    func validateSet(_ s: String) -> ValidationError? {
        guard !s.isEmpty else { return .cardSet("Set is required.") }
        return s.count <= 30 ? nil : .cardSet("Max 30 characters.")
    }

    func validateCardNumber(_ s: String?) -> ValidationError? {
        guard let s = s, !s.isEmpty else { return nil }
        let ok = s.count <= 10 && (s.range(of: "^[A-Za-z0-9]+$", options: .regularExpression) != nil)
        return ok ? nil : .cardNumber("Alphanumeric up to 10 chars.")
    }

    func validateEstimatedValue(_ s: String?) -> ValidationError? {
        guard let s = s, !s.isEmpty else { return nil }
        let pattern = "^(?:\\d{1,4}|\\d{1,4}\\.\\d{1,2})$" // up to 9999.99
        guard s.range(of: pattern, options: .regularExpression) != nil else {
            return .estimatedValue("Max $9,999.99 with up to 2 decimals.")
        }
        if let dec = Decimal(string: s), dec > 0 { return nil }
        return .estimatedValue("Must be a positive amount.")
    }
}

