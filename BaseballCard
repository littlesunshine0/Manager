// Helpers to safely access values that may not exist on BaseballCardModel
private extension BaseballCardModel {
    var marketValueDecimal: Decimal { (self.estimatedValue as? Decimal) ?? 0 }
    var marketValueDouble: Double { NSDecimalNumber(decimal: marketValueDecimal).doubleValue }
    var playerNameSafe: String { self.playerName }
    var isRookieSafe: Bool { self.rookie }
    var cardYearSafe: Int { self.cardYear }
    var isRawGrade: Bool { self.gradeCompany == .raw }
    var marketTrendString: String {
        // Try common property names without creating compile-time dependency
        if let mirrorTrend = Mirror(reflecting: self).children.first(where: { $0.label == "trend" })?.value as? String {
            return mirrorTrend
        }
        if let mirrorMarketTrend = Mirror(reflecting: self).children.first(where: { $0.label == "marketTrend" })?.value as? String {
            return mirrorMarketTrend
        }
        return ""
    }
}

// Local risk level for analytics
enum RiskLevel {
    case low, medium, high
}

// Advanced Portfolio Analytics (Market Movers/Alt style)
struct AdvancedAnalytics {
    
    // 1. High Concentration Risk Analysis
    static func analyzeConcentrationRisk(cards: [BaseballCardModel]) -> ConcentrationRisk {
        let totalValue: Decimal = cards.map { $0.marketValueDecimal }.reduce(0, +)
        
        // Group by player
        let playerValues = Dictionary(grouping: cards) { $0.playerNameSafe }
            .mapValues { playerCards in
                playerCards.map { $0.marketValueDecimal }.reduce(0, +)
            }
        
        // Find highest concentration
        let topPlayer = playerValues.max { $0.value < $1.value }
        let topPlayerValue = topPlayer?.value ?? 0
        let concentrationPercent = (NSDecimalNumber(decimal: totalValue).doubleValue > 0) ? (NSDecimalNumber(decimal: topPlayerValue).doubleValue / NSDecimalNumber(decimal: totalValue).doubleValue * 100.0) : 0
        
        let riskLevel: RiskLevel
        if concentrationPercent > 50 { riskLevel = .high }
        else if concentrationPercent > 30 { riskLevel = .medium }
        else { riskLevel = .low }
        
        return ConcentrationRisk(
            topPlayer: topPlayer?.key ?? "Unknown",
            concentrationPercent: concentrationPercent,
            riskLevel: riskLevel,
            recommendation: getRiskRecommendation(riskLevel, concentrationPercent)
        )
    }
    
    // 2. Vintage Premium Potential Analysis
    static func analyzeVintagePremium(cards: [BaseballCardModel]) -> [VintagePremium] {
        let vintageEras = [
            (1980...1985, "Early 80s Legends"),
            (1986...1994, "Junk Wax Era"),
            (1995...2005, "Modern Era"),
            (2006...2015, "Digital Era"),
            (2016...2024, "Current Era")
        ]
        
        return vintageEras.compactMap { (range, eraName) in
            let eraCards = cards.filter { range.contains($0.cardYearSafe) }
            guard !eraCards.isEmpty else { return nil }
            
            let avgValue: Decimal = eraCards.map { $0.marketValueDecimal }.reduce(0, +) / Decimal(eraCards.count)
            let premiumCards = eraCards.filter { $0.marketValueDecimal > (avgValue * 1.5) }
            
            let premiumPercent = Double(premiumCards.count) / Double(eraCards.count) * 100
            
            return VintagePremium(
                era: eraName,
                yearRange: "\(range.lowerBound)-\(range.upperBound)",
                totalCards: eraCards.count,
                premiumCards: premiumCards.count,
                premiumPercent: premiumPercent,
                avgValue: avgValue,
                opportunity: getVintageOpportunity(eraName, premiumPercent)
            )
        }
    }
    
    // 3. Rookie Card Focus Analysis
    static func analyzeRookieFocus(cards: [BaseballCardModel]) -> RookieFocus {
        let rookieCards = cards.filter { $0.isRookieSafe }
        let totalValue: Decimal = cards.map { $0.marketValueDecimal }.reduce(0, +)
        let rookieValue: Decimal = rookieCards.map { $0.marketValueDecimal }.reduce(0, +)
        
        let rookiePercent = (NSDecimalNumber(decimal: totalValue).doubleValue > 0) ? (NSDecimalNumber(decimal: rookieValue).doubleValue / NSDecimalNumber(decimal: totalValue).doubleValue * 100.0) : 0
        
        let topRookies = rookieCards.sorted { $0.marketValueDecimal > $1.marketValueDecimal }.prefix(5)
        
        return RookieFocus(
            totalRookies: rookieCards.count,
            rookieValuePercent: rookiePercent,
            rookieValue: rookieValue,
            topRookies: Array(topRookies),
            strategy: getRookieStrategy(rookiePercent)
        )
    }
    
    // 4. Portfolio Optimizer Suggestions
    static func generateOptimizationSuggestions(cards: [BaseballCardModel]) -> [OptimizationSuggestion] {
        var suggestions: [OptimizationSuggestion] = []
        
        // Concentration risk suggestion
        let concentration = analyzeConcentrationRisk(cards: cards)
        if concentration.riskLevel == .high {
            suggestions.append(OptimizationSuggestion(
                type: .diversification,
                priority: .high,
                title: "Reduce Concentration Risk",
                description: "Consider selling 25-30% of your \(concentration.topPlayer) holdings to diversify into other players or eras.",
                impact: "Reduce portfolio volatility by 15-20%"
            ))
        }
        
        // Grading opportunity
        let ungradedHighValue = cards.filter {
            $0.isRawGrade && $0.marketValueDecimal > 50
        }
        if ungradedHighValue.count > 0 {
            suggestions.append(OptimizationSuggestion(
                type: .grading,
                priority: .medium,
                title: "Grading Opportunity",
                description: "\(ungradedHighValue.count) high-value cards could benefit from professional grading.",
                impact: "Potential 20-40% value increase for PSA 9+ grades"
            ))
        }
        
        // Market timing
        let risingCards = cards.filter { $0.marketTrendString == "Rising" }
        if risingCards.count > 3 {
            suggestions.append(OptimizationSuggestion(
                type: .timing,
                priority: .low,
                title: "Market Timing Opportunity",
                description: "\(risingCards.count) cards showing upward trends - consider taking profits.",
                impact: "Lock in gains before potential market correction"
            ))
        }
        
        return suggestions
    }
    
    // Supporting functions
    private static func getRiskRecommendation(_ level: RiskLevel, _ percent: Double) -> String {
        switch level {
        case .high: return "Sell 25-30% of top holding to reduce risk"
        case .medium: return "Monitor closely, consider partial diversification"
        case .low: return "Well diversified portfolio"
        }
    }
    
    private static func getVintageOpportunity(_ era: String, _ premium: Double) -> String {
        if era.contains("Junk Wax") && premium > 15 {
            return "Strong premium cards in typically low-value era"
        } else if era.contains("Early 80s") && premium > 25 {
            return "Excellent vintage holdings with growth potential"
        } else {
            return "Standard distribution for era"
        }
    }
    
    private static func getRookieStrategy(_ percent: Double) -> String {
        if percent > 70 { return "High rookie focus - consider veteran balance" }
        else if percent > 40 { return "Strong rookie foundation" }
        else { return "Consider increasing rookie card allocation" }
    }
}

// Data structures
struct ConcentrationRisk {
    let topPlayer: String
    let concentrationPercent: Double
    let riskLevel: RiskLevel
    let recommendation: String
}

struct VintagePremium {
    let era: String
    let yearRange: String
    let totalCards: Int
    let premiumCards: Int
    let premiumPercent: Double
    let avgValue: Decimal
    let opportunity: String
}

struct RookieFocus {
    let totalRookies: Int
    let rookieValuePercent: Double
    let rookieValue: Decimal
    let topRookies: [BaseballCardModel]
    let strategy: String
}

struct OptimizationSuggestion {
    let type: SuggestionType
    let priority: Priority
    let title: String
    let description: String
    let impact: String
}


enum SuggestionType {
    case diversification, grading, timing, acquisition
}

enum Priority {
    case low, medium, high
    
    var color: Color {
        switch self {
        case .low: return .blue
        case .medium: return .orange
        case .high: return .red
        }
    }
}

