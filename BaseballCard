// MARK: - Common fetch helpers

public extension BaseballCard {
    static func fetchAllSortedRequest() -> NSFetchRequest<BaseballCard> {
        let req = fetchRequest()
        req.sortDescriptors = [
            NSSortDescriptor(key: #keyPath(BaseballCard.cardYear), ascending: false),
            NSSortDescriptor(key: #keyPath(BaseballCard.playerName), ascending: true),
            NSSortDescriptor(key: #keyPath(BaseballCard.brand), ascending: true),
            NSSortDescriptor(key: #keyPath(BaseballCard.setName), ascending: true),
            NSSortDescriptor(key: #keyPath(BaseballCard.cardNumber), ascending: true)
        ]
        return req
    }

    static func fetchByPlayer(_ name: String) -> NSFetchRequest<BaseballCard> {
        let req = fetchRequest()
        req.predicate = NSPredicate(format: "playerName CONTAINS[cd] %@", name)
        req.sortDescriptors = [
            NSSortDescriptor(key: #keyPath(BaseballCard.cardYear), ascending: false),
            NSSortDescriptor(key: #keyPath(BaseballCard.playerName), ascending: true)
        ]
        return req
    }

    static func fetchValuable(minEstimated: Decimal) -> NSFetchRequest<BaseballCard> {
        let req = fetchRequest()
        let min = NSDecimalNumber(decimal: minEstimated)
        req.predicate = NSPredicate(format: "estimatedValue >= %@", min)
        req.sortDescriptors = [
            NSSortDescriptor(key: #keyPath(BaseballCard.estimatedValue), ascending: false)
        ]
        return req
    }
}

