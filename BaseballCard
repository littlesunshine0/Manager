// MARK: - Core Data entity

@objc(BaseballCard)
public final class BaseballCard: NSManagedObject {
    @nonobjc
    public class func fetchRequest() -> NSFetchRequest<BaseballCard> {
        NSFetchRequest<BaseballCard>(entityName: "BaseballCard")
    }

    // Convenience fetch by identity tuple
    @nonobjc
    public class func fetchRequest(
        player: String,
        year: Int16,
        brand: String,
        setName: String,
        cardNumber: String
    ) -> NSFetchRequest<BaseballCard> {
        let req = fetchRequest()
        req.fetchLimit = 1
        req.predicate = NSPredicate(
            format: "playerName ==[c] %@ AND cardYear == %d AND brand ==[c] %@ AND setName ==[c] %@ AND cardNumber ==[c] %@",
            player, year, brand, setName, cardNumber
        )
        return req
    }
}

