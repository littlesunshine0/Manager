        )
    }
    
    // 79. Curated Feed
    func curateFeed(userInterests: [String], communityPosts: [CommunityPost]) -> [CommunityPost] {
        return communityPosts
            .filter { post in
                userInterests.contains { interest in
                    post.content.localizedCaseInsensitiveContains(interest) ||
                    post.tags.contains { $0.localizedCaseInsensitiveContains(interest) }
                }
            }
            .sorted { $0.relevanceScore > $1.relevanceScore }
    }
    
    // 80. Forum Post Summary
    func summarizeForumThread(posts: [ForumPost]) -> ThreadSummary {
        let keyPoints = extractKeyPoints(from: posts)
        let consensus = determineConsensus(from: posts)
        let sentiment = analyzeSentiment(posts.map { $0.content }.joined(separator: " "))
        
        return ThreadSummary(
            totalPosts: posts.count,
            keyPoints: keyPoints,
            consensus: consensus,
            sentiment: sentiment,
            summary: "Thread discusses \(keyPoints.first ?? "various topics") with \(sentiment.lowercased()) sentiment"
        )
    }
    
