            MarketSale(price: Decimal(string: "118.50")!, date: Calendar.current.date(byAdding: .day, value: -3, to: Date())!, platform: "PWCC", condition: "PSA 9"),
            MarketSale(price: Decimal(string: "132.00")!, date: Calendar.current.date(byAdding: .day, value: -7, to: Date())!, platform: "eBay", condition: "PSA 9"),
            MarketSale(price: Decimal(string: "95.00")!, date: Calendar.current.date(byAdding: .day, value: -14, to: Date())!, platform: "eBay", condition: "PSA 8")
        ]

        isLoading = false
        return mockSales
    }

    func getMarketTrend(sales: [MarketSale]) -> String {
        guard sales.count >= 2 else { return "Stable" }

        let recent = Array(sales.prefix(3).map { $0.price })
        let older = Array(sales.suffix(3).map { $0.price })

        let recentAvg = recent.reduce(0, +) / Decimal(recent.count)
        let olderAvg = older.reduce(0, +) / Decimal(older.count)

        guard olderAvg != 0 else { return "Stable" }
        let change = (recentAvg - olderAvg) / olderAvg * 100

        if change > 5 { return "Rising" }
        else if change < -5 { return "Falling" }
        else { return "Stable" }
    }

    struct MarketSale {
        let price: Decimal
        let date: Date
        let platform: String
        let condition: String
    }
}

