// 5) Minimal “Inline” List Using CardsQuery
private struct MiniCardsList: View {
    @StateObject private var query: CardsQuery
    @State private var filter = CardFilter()
    @State private var sort: CardSort = .yearDesc

    init(context: NSManagedObjectContext) {
        _query = StateObject(wrappedValue: CardsQuery(context: context))
    }

    var body: some View {
        List {
            ForEach(query.items, id: \.objectID) { card in
                CardRow(card: card)
            }
        }
        .task { try? query.apply(filter: filter, sort: sort) }
        .onChange(of: filter) { _ in try? query.apply(filter: filter, sort: sort) }
        .onChange(of: sort) { _ in try? query.apply(filter: filter, sort: sort) }
    }
}

