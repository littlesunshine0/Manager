    @Published var playerName: String = ""
    @Published var year: Int = 1990
    @Published var brand: String = ""
    @Published var setName: String = ""
    @Published var cardNumber: String = ""
    @Published var team: String = ""
    @Published var condition: CardCondition = .nearMint
    @Published var rookie: Bool = false
    @Published var autograph: Bool = false
    @Published var memorabilia: Bool = false
    @Published var estimatedValueText: String = ""

    // Errors
    @Published var errors: [ValidationService.ValidationError] = []

    private let manager: CoreDataManager
    private let validator = ValidationService()

    init(context: NSManagedObjectContext) {
        self.manager = CoreDataManager(context: context)
    }

    func validate() -> Bool {
        var errs: [ValidationService.ValidationError] = []
        if let e = validator.validatePlayerName(playerName) { errs.append(e) }
        if let e = validator.validateYear(year) { errs.append(e) }
        if let e = validator.validateSet(setName) { errs.append(e) }
        if let e = validator.validateCardNumber(cardNumber) { errs.append(e) }
        if let e = validator.validateEstimatedValue(estimatedValueText) { errs.append(e) }
        errors = errs
        return errs.isEmpty
    }

    func save() throws {
        guard validate() else { return }
        var model = BaseballCardModel(
            playerName: playerName,
            cardYear: year,
            brand: brand,
            setName: setName,
            cardNumber: cardNumber.isEmpty ? "-" : cardNumber
        )
        model.team = team.isEmpty ? nil : team
        model.rookie = rookie
        model.autograph = autograph
        model.memorabilia = memorabilia
        if !estimatedValueText.isEmpty { model.estimatedValue = Decimal(string: estimatedValueText) }
        try manager.create(from: model)
    }
}

