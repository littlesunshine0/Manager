struct CollectionStats {
    // Hero
    var totalCards: Int = 0
    var portfolioValue: Decimal = 0
    var costBasis: Decimal = 0
    var unrealizedPL: Decimal { portfolioValue - costBasis }
    var roiPercent: Double {
        guard costBasis > 0 else { return 0 }
        return (NSDecimalNumber(decimal: portfolioValue / costBasis - 1).doubleValue) * 100
    }
    var gradedCount: Int = 0
    var rawCount: Int { totalCards - gradedCount }

    // Hits & rarity
    var rookies: Int = 0
    var autographs: Int = 0
    var memorabilia: Int = 0
    var numbered: Int = 0
    var parallels: Int = 0

    // Graders
    var psa: Int = 0
    var sgc: Int = 0
    var bgs: Int = 0

    // Value buckets
    var v_1_24: Int = 0
    var v_25_99: Int = 0
    var v_100_499: Int = 0
    var v_500_999: Int = 0
    var v_1000_plus: Int = 0

    // Freshness & hygiene
    var new30d: Int = 0
    var stale90d: Int = 0
    var unpriced: Int = 0
    var missingImages: Int = 0
    var duplicateTuples: Int = 0
}

@MainActor
final class StatsService {
    private let ctx: NSManagedObjectContext
    init(ctx: NSManagedObjectContext) { self.ctx = ctx }

    func compute() throws -> CollectionStats {
        var s = CollectionStats()
        // Totals via count + SUM expressions
        s.totalCards = try ctx.count(for: req(nil))

        s.portfolioValue = try sumDecimal("estimatedValue")
        s.costBasis     = try sumDecimal("purchasePrice")

        // Graded vs raw
        s.gradedCount = try ctx.count(for: req(NSPredicate(format: "gradeCompanyRaw != %d", GradingCompany.raw.rawValue)))

        // Hits & rarity
        s.rookies    = try ctx.count(for: req(NSPredicate(format: "rookie == YES")))
        s.autographs = try ctx.count(for: req(NSPredicate(format: "autograph == YES")))
        s.memorabilia = try ctx.count(for: req(NSPredicate(format: "memorabilia == YES")))
        s.numbered   = try ctx.count(for: req(NSPredicate(format: "serialNumber != nil AND serialNumber != ''")))
        s.parallels  = try ctx.count(for: req(NSPredicate(format: "parallel != nil AND parallel != ''")))

        // Graders
        s.psa = try ctx.count(for: req(NSPredicate(format: "gradeCompanyRaw == %d", GradingCompany.psa.rawValue)))
        s.sgc = try ctx.count(for: req(NSPredicate(format: "gradeCompanyRaw == %d", GradingCompany.sgc.rawValue)))
        s.bgs = try ctx.count(for: req(NSPredicate(format: "gradeCompanyRaw == %d", GradingCompany.bgs.rawValue)))

        // Value buckets (treat nil as 0 by excluding nils)
        s.v_1_24    = try ctx.count(for: req(NSPredicate(format: "estimatedValue >= 1 AND estimatedValue <= 24")))
        s.v_25_99   = try ctx.count(for: req(NSPredicate(format: "estimatedValue >= 25 AND estimatedValue <= 99")))
        s.v_100_499 = try ctx.count(for: req(NSPredicate(format: "estimatedValue >= 100 AND estimatedValue <= 499")))
        s.v_500_999 = try ctx.count(for: req(NSPredicate(format: "estimatedValue >= 500 AND estimatedValue <= 999")))
        s.v_1000_plus = try ctx.count(for: req(NSPredicate(format: "estimatedValue >= 1000")))

        // Freshness (absolute date thresholds to avoid TZ mistakes)
        let now = Date()
        let days30 = Calendar.current.date(byAdding: .day, value: -30, to: now)!
        let days90 = Calendar.current.date(byAdding: .day, value: -90, to: now)!
        s.new30d   = try ctx.count(for: req(NSPredicate(format: "createdAt >= %@", days30 as NSDate)))
        s.stale90d = try ctx.count(for: req(NSPredicate(format: "updatedAt < %@", days90 as NSDate)))

        // Hygiene
        s.unpriced      = try ctx.count(for: req(NSPredicate(format: "estimatedValue == nil")))
        s.missingImages = try ctx.count(for: req(NSPredicate(format: "frontImagePath == nil OR frontImagePath == '' OR backImagePath == nil OR backImagePath == ''")))
        s.duplicateTuples = try findDuplicateIdentityTuplesCount()

        return s
    }

    private func req(_ predicate: NSPredicate?) -> NSFetchRequest<BaseballCard> {
        let r: NSFetchRequest<BaseballCard> = BaseballCard.fetchRequest()
        r.includesPropertyValues = false
        r.includesSubentities = false
        r.predicate = predicate
        return r
    }

    private func sumDecimal(_ key: String) throws -> Decimal {
        let fr = NSFetchRequest<NSDictionary>(entityName: "BaseballCard")
        fr.resultType = .dictionaryResultType
        let sum = NSExpressionDescription()
        sum.name = "sum"
        sum.expression = NSExpression(forFunction: "sum:", arguments: [NSExpression(forKeyPath: key)])
        sum.expressionResultType = .decimalAttributeType
        fr.propertiesToFetch = [sum]
        let dict = try ctx.fetch(fr).first
        let num = dict?["sum"] as? NSDecimalNumber ?? 0
        return num.decimalValue
    }

    // Group by (year, brand, setName, cardNumber, playerName) to catch dupes
    private func findDuplicateIdentityTuplesCount() throws -> Int {
        let fr = NSFetchRequest<NSDictionary>(entityName: "BaseballCard")
        fr.resultType = .dictionaryResultType
        fr.propertiesToGroupBy = ["cardYear","brand","setName","cardNumber","playerName"]

        let countDesc = NSExpressionDescription()
        countDesc.name = "cnt"
        countDesc.expression = NSExpression(forFunction: "count:", arguments: [NSExpression(forKeyPath: "id")])
        countDesc.expressionResultType = .integer64AttributeType

        fr.propertiesToFetch = ["cardYear","brand","setName","cardNumber","playerName", countDesc]

        let rows = try ctx.fetch(fr)
        return rows.reduce(0) { acc, row in
            let c = (row["cnt"] as? Int) ?? 0
            return acc + max(0, c - 1) // count extras beyond the first
        }
    }
}


