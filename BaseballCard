        let playerNames = ["griffey", "thomas", "jeter", "chipper", "piazza", "bagwell", "rodriguez"]
        for player in playerNames {
            if lowercaseMessage.contains(player) {
                if !userProfile.preferences.favoritePlayers.contains(player.capitalized) {
                    userProfile.preferences.favoritePlayers.append(player.capitalized)
                    
